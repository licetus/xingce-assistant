.tabs {
  display: flex;
  background: var(--card);
  border-bottom: 2rpx solid var(--line);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-2);
}

.tab.is-active {
  color: var(--brand);
  font-weight: 500;
  border-bottom: 4rpx solid var(--brand);
}

.me-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.me-rank {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--brand);
}

.rank-list {
  padding: 8rpx 32rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-no {
  width: 60rpx;
  font-size: 30rpx;
  color: var(--text-3);
}

.rank-no.is-top {
  color: var(--brand);
  font-weight: 500;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--line);
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-val {
  font-size: 26rpx;
  color: var(--text-2);
}

.empty {
  padding: 100rpx 0;
  text-align: center;
}
