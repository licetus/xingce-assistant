<view class="qc">
  <view class="qc-head">
    <view class="qc-head-left">
      <text class="qc-index">{{index + 1}}<text class="qc-total">/{{total}}</text></text>
      <view class="qc-tags">
        <!-- 标签文案由组件 JS 预计算（sourceLabel）：真题显示具体出处（如「2024国考·地市级」） -->
        <text class="tag {{q.source === 'ai' ? 'tag-ai' : ''}}">{{sourceLabel}}</text>
        <text class="tag" wx:if="{{q.subtype}}">{{q.subtype}}</text>
        <text class="qc-diff">难度 {{q.difficulty}}</text>
      </view>
    </view>
    <!-- 题头收藏按钮：做题过程中随时可收藏/取消，状态由页面传入（faved） -->
    <view
      class="qc-fav-btn {{faved ? 'is-faved' : ''}}"
      hover-class="qc-fav-btn-hover"
      bindtap="onToggleFav"
    >{{faved ? '★ 已收藏' : '☆ 收藏'}}</view>
  </view>

  <view class="qc-stem">
    <text wx:if="{{q.type === 'multi'}}" class="qc-multi-tip">多选</text>
    <text>{{q.stem}}</text>
  </view>

  <image
    wx:for="{{q.images}}"
    wx:key="*this"
    class="qc-img"
    src="{{item}}"
    mode="widthFix"
    lazy-load="{{true}}"
    wx:if="{{q.images.length}}"
  />

  <view class="qc-options">
    <!-- 高亮标记由组件 JS 预计算（viewOptions.isChosen/isRight/isWrong）：
         WXML Mustache 不支持 indexOf 等方法调用，不能在这里现算 -->
    <view
      wx:for="{{viewOptions}}"
      wx:key="key"
      class="qc-option {{item.isChosen ? 'is-chosen' : ''}} {{item.isRight ? 'is-right' : ''}} {{item.isWrong ? 'is-wrong' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTapOption"
    >
      <text class="qc-key">{{item.key}}</text>
      <text class="qc-text">{{item.text}}</text>
    </view>
  </view>

  <view wx:if="{{q.type === 'multi' && !result}}" class="qc-confirm btn {{chosen.length ? '' : 'btn-disabled'}}" bindtap="onConfirmMulti">
    确定
  </view>

  <view wx:if="{{result}}" class="qc-analysis">
    <view class="qc-verdict {{result.correct ? 'ok' : 'no'}}">
      {{result.correct ? '回答正确' : '回答错误'}}
      <text class="qc-answer">正确答案 {{answerText}}</text>
    </view>

    <view class="qc-ana-toggle" bindtap="toggleAnalysis">
      {{showAnalysis ? '收起解析' : '查看解析'}}
    </view>

    <view wx:if="{{showAnalysis}}" class="qc-ana-body">
      <text>{{result.analysis}}</text>
    </view>

    <view class="qc-ana-foot">
      <text bindtap="onToggleFav" class="qc-fav {{faved ? 'is-faved' : ''}}">{{faved ? '★ 已收藏' : '☆ 收藏本题'}}</text>
    </view>
  </view>
</view>
