.qc {
  padding: 32rpx;
}

.qc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.qc-head-left {
  display: flex;
  align-items: center;
  min-width: 0; /* 允许 tags 区被压缩省略，不挤压右侧收藏按钮 */
}

/* 题头收藏按钮：随时可点，未收藏浅底描边，已收藏品牌色高亮 */
.qc-fav-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-capsule);
  background: var(--bg);
  border: 1rpx solid var(--line);
  color: var(--text-2);
  font-size: 24rpx;
}

.qc-fav-btn.is-faved {
  background: var(--brand-light);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 500;
}

.qc-fav-btn-hover {
  opacity: 0.7;
}

.qc-index {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--brand);
}

.qc-total {
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 400;
}

.qc-tags {
  display: flex;
  align-items: center;
}

.qc-diff {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}

/* AI 生成题标签（V1.1 上线生成功能后出现），与真题标签做视觉区分 */
.tag-ai {
  background: var(--warning);
  color: var(--text-inverse);
}

/* 标签防御：subtype 等字段若被脏数据塞入长文本，截断省略而不是撑爆头部布局 */
.qc-tags .tag {
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qc-stem {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-1);
  margin-bottom: 32rpx;
}

.qc-multi-tip {
  display: inline-block;
  background: var(--warning);
  color: var(--text-inverse);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  vertical-align: middle;
}

.qc-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.qc-options {
  margin-bottom: 24rpx;
}

.qc-option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  transition: background 0.15s;
}

.qc-key {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.qc-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-1);
}

.qc-option.is-chosen {
  border-color: var(--brand);
  background: var(--brand-light);
}

.qc-option.is-chosen .qc-key {
  background: var(--brand);
  color: var(--text-inverse);
}

.qc-option.is-right {
  border-color: var(--success);
  background: var(--success-light);
}

.qc-option.is-right .qc-key {
  background: var(--success);
  color: var(--text-inverse);
}

.qc-option.is-wrong {
  border-color: var(--danger);
  background: var(--danger-light);
}

.qc-option.is-wrong .qc-key {
  background: var(--danger);
  color: var(--text-inverse);
}

.qc-confirm {
  margin-top: 8rpx;
}

.qc-analysis {
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.qc-verdict {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.qc-verdict.ok {
  color: var(--success);
}

.qc-verdict.no {
  color: var(--danger);
}

.qc-answer {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 400;
  margin-left: 16rpx;
}

.qc-ana-toggle {
  font-size: 26rpx;
  color: var(--brand);
  padding: 12rpx 0;
}

.qc-ana-body {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--text-2);
  padding: 16rpx 0;
  border-top: 2rpx solid var(--line);
  margin-top: 8rpx;
}

.qc-ana-foot {
  text-align: right;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--line);
}

.qc-fav {
  display: inline-block;
  font-size: 24rpx;
  color: var(--brand);
  padding: 10rpx 26rpx;
  border-radius: var(--radius-capsule);
  background: var(--bg);
  border: 1rpx solid var(--line);
}

.qc-fav.is-faved {
  background: var(--brand-light);
  border-color: var(--brand);
  font-weight: 500;
}
