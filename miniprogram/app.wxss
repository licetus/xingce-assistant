@import "styles/tokens.wxss";

page {
  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  font-family: var(--font-sans);
  line-height: 1.6;
}

view, text, scroll-view, button, input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  margin: 24rpx;
  padding: 32rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--text-3);
  font-size: 24rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: var(--brand-light);
  color: var(--brand);
}

.btn-disabled {
  background: #C9CDD4;
  color: #fff;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 22rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 等宽数字：计时器、正确率、统计数字都要加，
   否则秒数从 9 跳到 10 时宽度变化会引起整行抖动 */
.tnum {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* 深色卡片：首页「今日目标」，设计稿专用深底 */
.card-dark {
  background: var(--card-dark);
  color: var(--text-inverse);
  border-radius: var(--radius);
  margin: 24rpx;
  padding: 32rpx;
}

/* 胶囊筛选标签：题库页筛选 chips */
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-capsule);
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.4;
}

.chip-active {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
}
