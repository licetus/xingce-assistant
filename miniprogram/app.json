{
  "pages": [
    "pages/index/index",
    "pages/practice/practice",
    "pages/result/result",
    "pages/wrong/wrong",
    "pages/mine/mine"
  ],
  "subpackages": [
    {
      "root": "pkg-rank",
      "name": "打卡排行",
      "pages": [
        "pages/checkin/checkin",
        "pages/rank/rank",
        "pages/poster/poster"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pkg-rank"]
    },
    "pages/mine/mine": {
      "network": "wifi",
      "packages": ["pkg-rank"]
    }
  },
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTitleText": "行测小助手",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F5F6F8"
  },
  "tabBar": {
    "color": "#9A9EA6",
    "selectedColor": "#2B6CF6",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/tabbar/home.png",
        "selectedIconPath": "assets/tabbar/home_on.png"
      },
      {
        "pagePath": "pages/practice/practice",
        "text": "练习",
        "iconPath": "assets/tabbar/practice.png",
        "selectedIconPath": "assets/tabbar/practice_on.png"
      },
      {
        "pagePath": "pages/wrong/wrong",
        "text": "错题本",
        "iconPath": "assets/tabbar/wrong.png",
        "selectedIconPath": "assets/tabbar/wrong_on.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/tabbar/mine.png",
        "selectedIconPath": "assets/tabbar/mine_on.png"
      }
    ]
  },
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存学习战报海报到相册"
    }
  },
  "requiredPrivateInfos": [],
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "renderer": "webview"
}
