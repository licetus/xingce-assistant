<view class="page">
  <view class="profile">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
    </button>
    <input
      class="nickname"
      type="nickname"
      value="{{nickName}}"
      placeholder="点击设置昵称"
      bindblur="onNicknameBlur"
      maxlength="16"
    />
  </view>

  <view class="card stat-row">
    <view class="stat-item">
      <view class="stat-num">{{totalDone}}</view>
      <view class="muted">累计刷题</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{accuracy}}%</view>
      <view class="muted">总正确率</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{totalDays}}</view>
      <view class="muted">打卡天数</view>
    </view>
  </view>

  <view class="section-title">模块表现</view>
  <view class="card">
    <view class="mod-row" wx:for="{{modules}}" wx:key="name">
      <text class="mod-name">{{item.name}}</text>
      <view class="mod-bar-wrap">
        <view class="mod-bar" style="width: {{item.accuracy}}%"></view>
      </view>
      <text class="mod-val">{{item.done ? item.accuracy + '%' : '—'}}</text>
    </view>
  </view>

  <view class="card link-row" bindtap="onOpenPrivacy">
    <text>用户隐私保护指引</text>
    <text class="arrow">›</text>
  </view>

  <!-- 调试面板：config.debug_mode=true 时显示，audit_mode 下强制隐藏 -->
  <view class="debug" wx:if="{{debugMode}}">
    <view class="debug-head">🛠 调试模式（config.debug_mode）</view>

    <view class="debug-row">
      <text class="debug-k">版本 / 环境</text>
      <text class="debug-v">{{debugInfo.version}} · {{debugInfo.envVersion}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-k">audit_mode</text>
      <text class="debug-v">{{debugInfo.auditMode ? '开（排行榜/广告/本面板已隐藏）' : '关'}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-k">Banner / 激励视频</text>
      <text class="debug-v">{{debugInfo.banner}} / {{debugInfo.video}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-k">插屏状态</text>
      <text class="debug-v">{{debugInfo.interstitial}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-k">订阅模板</text>
      <text class="debug-v">{{debugInfo.tmpl}}</text>
    </view>
    <view class="debug-row">
      <text class="debug-k">config 字段</text>
      <text class="debug-v">{{debugInfo.configKeys}}</text>
    </view>

    <view class="debug-actions">
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugForceCheck">模拟旧版本强更</view>
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugSoftCheck">柔性更新提示</view>
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugInterstitial">立即弹插屏（忽略频控）</view>
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugVideo">播放激励视频</view>
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugSubscribe">拉起订阅授权</view>
      <view class="debug-btn" hover-class="debug-btn-hover" bindtap="onDebugPrivacy">打开隐私协议</view>
    </view>
  </view>
</view>
