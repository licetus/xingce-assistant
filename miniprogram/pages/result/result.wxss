.result {
  background: #fff;
  min-height: 100vh;
}

.score-card {
  padding: 100rpx 32rpx 60rpx;
  text-align: center;
}

.score-num {
  font-size: 120rpx;
  font-weight: 500;
  color: var(--brand);
  line-height: 1;
}

.score-unit {
  font-size: 44rpx;
  margin-left: 8rpx;
}

.score-label {
  font-size: 28rpx;
  color: var(--text-2);
  margin-top: 16rpx;
}

.score-detail {
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

.score-beat {
  display: inline-block;
  margin-top: 28rpx;
  padding: 10rpx 28rpx;
  background: var(--brand-light);
  color: var(--brand);
  border-radius: 32rpx;
  font-size: 26rpx;
}

.streak {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--brand);
}

.actions {
  padding: 24rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
}

.back-home {
  text-align: center;
  padding: 32rpx;
  color: var(--text-3);
  font-size: 26rpx;
}
