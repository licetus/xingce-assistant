/* ============ 顶部问候 ============ */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 32rpx;
}

.greeting {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-1);
}

.greeting-sub {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg);
}

/* ============ 今日目标 · 深色卡 ============ */
.goal-card {
  margin: 0 32rpx;
  padding: 36rpx 32rpx;
  border-radius: var(--radius);
  background: var(--card-dark);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goal-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-inverse);
}

.goal-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
}

.goal-btn {
  flex-shrink: 0;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-capsule);
  background: var(--brand);
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: 500;
}

.goal-btn-done {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
}

.goal-btn-hover {
  background: var(--brand-dark);
}

.goal-btn-done.goal-btn-hover {
  background: rgba(255, 255, 255, 0.1);
}

/* ============ 专项练习 6 宫格 ============ */
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-1);
  padding: 40rpx 32rpx 16rpx;
}

.grid-card {
  margin: 0 16rpx;
  padding: 8rpx 0;
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 33.33%;
  box-sizing: border-box;
  padding: 28rpx 0 24rpx;
  text-align: center;
  border-radius: var(--radius-sm);
}

.grid-item-hover {
  background: var(--bg);
}

/* 深色 hairline：卡片内 2 行 3 列的网格线 */
.grid-item:not(:nth-child(3n)) {
  border-right: 1rpx solid var(--line);
}

.grid-item:nth-child(n + 4) {
  border-top: 1rpx solid var(--line);
}

.grid-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 500;
}

.grid-icon-shuffle {
  background: var(--success-light);
  color: var(--success);
}

.grid-name {
  font-size: 26rpx;
  color: var(--text-1);
  margin-top: 14rpx;
}

.grid-meta {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* ============ 快捷入口 ============ */
.quick-row {
  display: flex;
  padding: 24rpx 16rpx 0;
}

.quick-item {
  flex: 1;
  margin: 0 8rpx;
  text-align: center;
  padding: 32rpx 16rpx;
}

.quick-hover {
  background: var(--bg);
}

.quick-num {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--brand);
  margin-bottom: 4rpx;
}

/* ---------- 流量主 Banner 广告 ---------- */
/* wx:if 已控制渲染，这里只管与卡片区的间距节奏 */
.ad-slot {
  margin-top: var(--space-md);
}

/* ============ 骨架屏（冷启动占位） ============ */
/* 透明度脉冲：比 background-position 扫光在 webview/skyline 下兼容性都稳 */
.sk {
  background: var(--line);
  border-radius: var(--radius-sm);
  animation: sk-pulse 1.4s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* 深色卡内的骨架块 */
.sk-dark {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 6rpx;
}

/* 尺寸一一对应真实元素，切换时位置不跳 */
.sk-greeting {
  width: 300rpx;
  height: 44rpx;
}

.sk-sub {
  width: 200rpx;
  height: 28rpx;
  margin-top: 14rpx;
}

.sk-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.sk-goal-title {
  width: 250rpx;
  height: 36rpx;
}

.sk-goal-sub {
  width: 190rpx;
  height: 26rpx;
  margin-top: 14rpx;
}

.sk-goal-btn {
  width: 148rpx;
  height: 72rpx;
  border-radius: var(--radius-capsule);
}

.sk-section {
  width: 132rpx;
  height: 32rpx;
}

.sk-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 20rpx;
}

.sk-grid-name {
  width: 96rpx;
  height: 26rpx;
  margin: 14rpx auto 0;
}

.sk-grid-meta {
  width: 72rpx;
  height: 20rpx;
  margin: 8rpx auto 0;
}

.sk-num {
  width: 76rpx;
  height: 44rpx;
  margin: 0 auto 10rpx;
}

.sk-quick-label {
  width: 128rpx;
  height: 24rpx;
  margin: 0 auto;
}
