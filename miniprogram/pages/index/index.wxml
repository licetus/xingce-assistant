<view class="page">

  <!-- 顶部问候 + 头像 -->
  <view class="header">
    <view class="header-text">
      <view class="greeting">{{greeting}}，{{nickName || '考友'}}</view>
      <view class="greeting-sub" wx:if="{{totalDone > 0}}">已练 {{totalDone}} 题 · 正确率 {{accuracy}}%</view>
      <view class="greeting-sub" wx:else>开始你的第一次练习</view>
    </view>
    <image
      class="avatar"
      src="{{avatarUrl || '/assets/default-avatar.png'}}"
      bindtap="onTapMine"
    />
  </view>

  <!-- 今日目标 · 深色卡 -->
  <view class="goal-card" bindtap="onTapCheckin">
    <view class="goal-main">
      <view class="goal-title">今日目标 · 10 题</view>
      <view class="goal-sub">
        <block wx:if="{{todayChecked}}">今日已完成 · 连续 {{streak}} 天</block>
        <block wx:elif="{{streak > 0}}">已连续 {{streak}} 天，别断了</block>
        <block wx:else>每天 10 题，坚持看得见</block>
      </view>
    </view>
    <view class="goal-btn {{todayChecked ? 'goal-btn-done' : ''}}" hover-class="goal-btn-hover">
      {{todayChecked ? '已打卡' : '去打卡'}}
    </view>
  </view>

  <!-- 专项练习 6 宫格 -->
  <view class="section-title">专项练习</view>
  <view class="card grid-card">
    <view
      class="grid-item"
      wx:for="{{modules}}"
      wx:key="name"
      hover-class="grid-item-hover"
      data-name="{{item.name}}"
      bindtap="onTapModule"
    >
      <view class="grid-icon">{{item.icon}}</view>
      <view class="grid-name">{{item.name}}</view>
      <view class="grid-meta">
        <block wx:if="{{item.done > 0}}">{{item.done}} 题 · {{item.accuracy}}%</block>
        <block wx:else>未开始</block>
      </view>
    </view>
    <view
      class="grid-item grid-item-random"
      hover-class="grid-item-hover"
      bindtap="onTapRandom"
    >
      <view class="grid-icon grid-icon-shuffle">随</view>
      <view class="grid-name">随机练习</view>
      <view class="grid-meta">五模块混合</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-row">
    <view class="card quick-item" hover-class="quick-hover" bindtap="onTapWrong">
      <view class="quick-num tnum">{{wrongCount}}</view>
      <view class="muted">错题待复习</view>
    </view>
    <view class="card quick-item" hover-class="quick-hover" bindtap="onTapRank" wx:if="{{showRank}}">
      <view class="quick-num tnum">{{streak}}</view>
      <view class="muted">打卡排行榜</view>
    </view>
  </view>

</view>
